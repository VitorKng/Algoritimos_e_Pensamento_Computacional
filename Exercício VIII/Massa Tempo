#include <stdio.h>

int main() {
  float massa_inicial, massa;
  int t = 0;

  printf("Massa inicial (g): ");
  scanf("%f", &massa_inicial);
   
  massa = massa_inicial;

  while (massa >= 0.5) {
    massa /= 2;
    t += 50;
  }

  printf("Massa inicial: %.2f g\n", massa_inicial);
  printf("Massa final:  %.4f g\n", massa);
  printf("Tempo total:  %d h %d min %d s\n", t / 3600, (t % 3600) / 60, t % 60);

  return 0;
}
