#include <stdio.h>

int main() {
   int vetor[10];
   int i;
   int primeiro = 1;
   
   for (i = 0; i < 10; i++){
       scanf("%d", &vetor[i]);
   }
   
   printf("Saida: ");
   for (i = 9; i >= 0; i--){
       if(vetor[i] % 2 != 0){
       if (!primeiro) {
           printf(", ");
       }
       printf("%d", vetor[i]);
       primeiro = 0;
   }
   }
   
   return 0;
}
