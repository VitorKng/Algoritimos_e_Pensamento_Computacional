#include <stdio.h>

int main() {
    int matriz[3][3];
    int lin, col;

    printf("Digite os elementos da matriz 3x3:\n");
    for (lin = 0; lin < 3; lin++) {
        for (col = 0; col < 3; col++) {
            printf("Elemento [%d][%d]: ", lin, col);
            scanf("%d", &matriz[lin][col]);
        }
    }

    printf("\nSoma dos elementos de cada linha:\n");
    for (lin = 0; lin < 3; lin++) {
        int soma_linha = 0;
        for (col = 0; col < 3; col++) {
            soma_linha += matriz[lin][col];
        }
        printf("Linha %d: %d\n", lin, soma_linha);
    }

    return 0;
}
