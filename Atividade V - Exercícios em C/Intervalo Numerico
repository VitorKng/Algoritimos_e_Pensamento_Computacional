#include <stdio.h>

int main()
{
  int num1, num2;
   
  printf("Digite o primeiro número: ");
  scanf("%d", &num1);
   
  printf("Digite o segundo número: ");
  scanf("%d", &num2);
   
  printf("Numeros no intervalo:\n");
   
  if (num1 < num2) {
    for (int i = num1+1; i<num2; i++){
      printf("%d", i);
    }
  } else { 
    for (int i = num2+1; i<num1; i++){
      printf("%d", i);
    }
     
    }

  return 0;
}
