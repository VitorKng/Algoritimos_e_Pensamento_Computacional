#include <stdio.h>

int main(){
  int num1, num2, num3;

  printf("Identifque os números\n\n");
  printf("Dê o primeiro número: ");
  scanf("%d", &num1);

  printf("Dê o segundo número: ");
  scanf("%d", &num2);
   
  printf("Dê o terceiro número: ");
  scanf("%d", &num3);
   
  if (num1 > num2 && num1 > num3){
    printf("\nO primeiro número é maior.\n\n", num1);
  }else if (num2 > num1 && num2 > num3) {
    printf("O segundo número é maior.\n\n", num2);
  }else {
    printf("O terceiro número é maior.\n\n", num3);
  }
   
  if (num1 <= num2 && num1 <= num3){
    printf("O primeiro número é menor.", num1);
  }else if (num2 <= num1 && num2 <= num3) {
    printf("O segundo número é menor.", num2);
  }else {
    printf("O terceiro número é menor.", num3);
  }

  return 0;
}
