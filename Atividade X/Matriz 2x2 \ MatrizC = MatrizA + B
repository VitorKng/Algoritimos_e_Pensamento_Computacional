#include <stdio.h>

int main() {
    int matrizA[2][2], matrizB[2][2], matrizC[2][2];

    for (int lin = 0; lin < 2; lin++) {
        for (int col = 0; col < 2; col++) {
            scanf("%d", &matrizA[lin][col]);
        }
    }

    for (int lin = 0; lin < 2; lin++) {
        for (int col = 0; col < 2; col++) {
            scanf("%d", &matrizB[lin][col]);
        }
    }

    for (int lin = 0; lin < 2; lin++) {
        for (int col = 0; col < 2; col++) {
            matrizC[lin][col] = matrizA[lin][col] + matrizB[lin][col];
        }
    }

    printf("Matriz C\n");
    for (int lin = 0; lin < 2; lin++) {
        for (int col = 0; col < 2; col++) {
            printf("%d ", matrizC[lin][col]);
        }
        printf("\n");
    }

    return 0;
}
