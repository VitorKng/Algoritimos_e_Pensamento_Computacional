#include <stdio.h>

int main() {
    int matriz[3][3];

    for (int lin = 0; lin < 3; lin++) {
        for (int col = 0; col < 3; col++) {
            scanf("%d", &matriz[lin][col]);
        }
    }

    for (int lin = 0; lin < 3; lin++) {
        printf("%d", matriz[lin][lin]);
        if (lin < 2) {
            printf(" ");
        }
    }
    printf("\n");

    return 0;
}
